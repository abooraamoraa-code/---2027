# ==========================================
# NOVA DATA AI
# Environment Configuration
# ==========================================

# Server
PORT=3000
HOST=0.0.0.0

# Application
APP_NAME=NOVA DATA AI
APP_VERSION=1.0.0
NODE_ENV=development

# Security
MAX_BODY_SIZE=10mb
REQUEST_TIMEOUT=15000

# Data Collection
MAX_REMOTE_DATA_SIZE=5242880
MAX_DATASET_RECORDS=100000

# Validation
VALIDATION_LEVEL=standard

# Privacy
PRIVACY_SCAN_ENABLED=true

# Logging
LOG_LEVEL=info

# Future AI Integration
AI_PROVIDER=
AI_API_KEY=

# Future Database
DATABASE_URL=

# Future Storage
STORAGE_URL=

# Future GitHub Integration
GITHUB_TOKEN=

# Future Marketplace
MARKETPLACE_ENABLED=false
